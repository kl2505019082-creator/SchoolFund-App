<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_white"
        android:elevation="2dp"
        android:padding="18dp"
        android:layout_marginBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/textEventName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/buttonDeleteEvent"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="2dp"
                android:src="@drawable/ic_trash"
                android:contentDescription="Delete event" />
        </LinearLayout>

        <TextView
            android:id="@+id/textEventBudget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/primary_green"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textEventSpent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/danger_red"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textEventRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonAddEventTransaction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/btn_primary_green"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true">
        <ImageView android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_plus" android:layout_marginEnd="8dp"
            app:tint="#FFFFFF" android:contentDescription="Add" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Add transaction for this event" android:textStyle="bold"
            android:textColor="#FFFFFF" android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transactions for this event"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEventTransactions"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
