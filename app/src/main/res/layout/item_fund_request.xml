<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_white_stroke"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textReqTeacher"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textReqAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/textReqReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/textReqMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/textReqStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/pill_status_bg" />

        <TextView
            android:id="@+id/buttonClearRequest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_clear_request"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:padding="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/textReqRemarks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/card_white_stroke"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/buttonViewWorkPaper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_view_work_paper"
        android:textColor="@color/accent_blue"
        android:textStyle="bold"
        android:textSize="12sp"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutReqActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/buttonApprove"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/btn_approve"
            android:textColor="@color/primary_green"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/pill_action_approve" />

        <View android:layout_width="10dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/buttonReject"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/btn_reject"
            android:textColor="@color/danger_red"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/pill_action_reject" />

        <TextView
            android:id="@+id/buttonDisburse"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/btn_disburse"
            android:textColor="@color/primary_green"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/pill_action_approve"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
