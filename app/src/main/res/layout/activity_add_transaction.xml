<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:id="@+id/bannerRecordingUnder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_white_stroke"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calendar"
                android:layout_marginEnd="8dp"
                android:contentDescription="Destination" />

            <TextView
                android:id="@+id/textRecordingUnder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recording under: General class fund"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/radioGroupType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/pill_status_bg"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="18dp">

            <RadioButton
                android:id="@+id/radioIncome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Income"
                android:gravity="center"
                android:button="@null"
                android:textColor="@color/primary_green"
                android:textStyle="bold"
                android:background="@drawable/card_white"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioExpense"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Expense"
                android:gravity="center"
                android:button="@null"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AMOUNT (RM)"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="6dp" />
        <EditText
            android:id="@+id/editAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="0.00"
            android:textSize="16sp"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESCRIPTION"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="6dp" />
        <EditText
            android:id="@+id/editDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Beli alat tulis kelas"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LINK TO EVENT BUDGET (OPTIONAL)"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="6dp" />
        <Spinner
            android:id="@+id/spinnerEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:id="@+id/buttonAttachReceipt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/btn_outline_neutral"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_camera"
                android:layout_marginEnd="8dp"
                android:contentDescription="Attach receipt" />

            <TextView
                android:id="@+id/textAttachReceiptLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attach receipt photo"
                android:textColor="@color/accent_orange"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imageReceiptPreview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@drawable/card_white_stroke"
            android:layout_marginBottom="20dp"
            android:contentDescription="Receipt preview" />

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Save transaction"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_green"
            android:backgroundTint="@null"
            android:textColor="#FFFFFF"
            android:elevation="2dp" />

    </LinearLayout>
</ScrollView>
